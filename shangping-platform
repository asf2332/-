def tc(text, width, header=False, center=False):
    shd = '<w:shd w:val="clear" w:color="auto" w:fill="D9D9D9"/>' if header else ""
    jc = "center" if (header or center) else "left"
    bold = "<w:b/>" if header else ""
    return (f'<w:tc><w:tcPr><w:tcW w:w="{width}" w:type="dxa"/>{shd}<w:vAlign w:val="center"/></w:tcPr>'
            f'<w:p><w:pPr><w:spacing w:line="312" w:lineRule="auto"/>'
            f'<w:ind w:firstLine="0" w:firstLineChars="0"/><w:jc w:val="{jc}"/>'
            f'<w:rPr><w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:eastAsia="宋体"/>{bold}</w:rPr></w:pPr>'
            f'<w:r><w:rPr><w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:eastAsia="宋体"/>{bold}</w:rPr>'
            f'<w:t>{esc(text)}</w:t></w:r></w:p></w:tc>')


def table(widths, headers, rows):
    n = len(widths)
    grid = "<w:tblGrid>" + "".join(f'<w:gridCol w:w="{w}"/>' for w in widths) + "</w:tblGrid>"
    out = ["<w:tbl>", TBLPR, grid]
    out.append("<w:tr>" + "".join(tc(h, w, header=True) for h, w in zip(headers, widths)) + "</w:tr>")
    for r in rows:
        out.append("<w:tr>" + "".join(tc(str(c), w) for c, w in zip(r, widths)) + "</w:tr>")
    out.append("</w:tbl>")
    # 表格后补一个空段，避免表格粘连
    out.append('<w:p><w:pPr><w:ind w:firstLine="0"/><w:rPr><w:sz w:val="21"/></w:rPr></w:pPr></w:p>')
    return "".join(out)


